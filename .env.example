# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token_here
FACEBOOK_API_VERSION=v19.0
FACEBOOK_PAGE_IDS=111222333444,555666777888   # comma-separated page IDs to monitor

# Ingestion settings
ACTIVE_WINDOW_DAYS=30       # how many days back to re-check posts for new comments

# Local paths (used during development; replaced by Azure Blob paths later)
CHECKPOINT_DIR=checkpoints
OUTPUT_DIR=data/raw
